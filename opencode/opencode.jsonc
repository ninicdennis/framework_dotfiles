{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "openrouter/anthropic/claude-haiku-4.5",
  "default_agent": "build",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000,
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      "*.lock",
      "coverage/**",
    ],
  },
  "permission": {
    "bash": {
      // Default: ask for anything not matched below
      "*": "ask",
      // Destructive — always denied globally as safety backstop
      "rm -rf *": "deny",
      "git push *": "deny",
      "git commit *": "deny",
      "sudo *": "deny",
      "dd *": "deny",
      "shutdown *": "deny",
      "reboot *": "deny",
      // Safe read & inspect
      "cat *": "allow",
      "ls *": "allow",
      "ls": "allow",
      "echo *": "allow",
      "pwd": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "which *": "allow",
      "env": "allow",
      "printenv *": "allow",
      // Network — safe local use
      "curl *": "allow",
      "wget *": "allow",
      // Git read-only
      "git status": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git diff": "allow",
      "git show *": "allow",
    },
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
    },
  },
  "agent": {
    "build": {
      "mode": "primary",
      "model": "openrouter/minimax/minimax-m2.7",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "ask",
          "rm -rf *": "deny",
          "git push *": "deny",
          "git commit *": "deny",
          "sudo *": "deny",
          "dd *": "deny",
          "mkfs *": "deny",
          "shutdown *": "deny",
          "reboot *": "deny",
          ":(){ :|:& };:": "deny",
          "rm *": "ask",
          "mv *": "ask",
          "cp *": "ask",
          "chmod *": "ask",
          "chown *": "ask",
          "ssh *": "ask",
          "docker *": "ask",
          "kill *": "ask",
          "pkill *": "ask",
          "systemctl *": "ask",
          "service *": "ask",
          "ls *": "allow",
          "ls": "allow",
          "cat *": "allow",
          "pwd": "allow",
          "echo *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "wc *": "allow",
          "find *": "allow",
          "grep *": "allow",
          "rg *": "allow",
          "which *": "allow",
          "env": "allow",
          "printenv *": "allow",
          "curl *": "allow",
          "wget *": "allow",
          "git status": "allow",
          "git diff *": "allow",
          "git diff": "allow",
          "git log *": "allow",
          "git show *": "allow",
          "pnpm *": "allow",
          "npm run *": "allow",
          "npx *": "allow",
          "yarn *": "allow",
          "bun *": "allow",
          "node *": "allow",
          "python *": "allow",
          "python3 *": "allow",
          "cargo *": "allow",
          "go *": "allow",
          "make *": "allow",
          "just *": "allow",
          "tsc *": "allow",
        },
      },
    },
    "plan": {
      "mode": "primary",
      "model": "openrouter/anthropic/claude-opus-4.8",
      "permission": {
        "edit": "ask",
        "bash": "ask",
      },
    },
    "project-researcher": {
      "mode": "primary",
      "model": "openrouter/anthropic/claude-opus-4.8",
    },
    "research-worker": {
      "mode": "subagent",
      "model": "openrouter/anthropic/claude-haiku-4.5",
    },
  },
  "tools": {
    "websearch": true,
    "codesearch": true,
  },
}
