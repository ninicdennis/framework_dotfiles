{
  "output": ["eDP-1", "DP-2", "DP-3"],
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 1,
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/submap",
    "cpu",
    "memory",
    "disk#ssd",
    "mpris"
  ],
  "modules-center": ["clock", "custom/weather"],
  "modules-right": [
    "tray",
    "idle_inhibitor",
    "network",
    "bluetooth",
    "custom/tailscale",
    "pulseaudio",
    "custom/powerprofile",
    "battery"
  ],
  "hyprland/workspaces": {
    "format": "{name}",
    "active-only": false, // show inactive too
    "all-outputs": true, // same slots on every monitor
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5] // reserve workspaces 1–5 everywhere
    }
  },
    "active-only": false, // show inactive too
    "all-outputs": true, // same slots on every monitor
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5] // reserve workspaces 1–5 everywhere
    }
  },
  "battery": {
    "interval": 5,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}% {icon}",
    "format-charging": " {capacity}% {icon}",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "{capacity}%\nWattage: {power}W\n{timeTo}",
    "max-length": 25
  },
  "bluetooth": {
    "format-on": "",
    "format-off": "󰂲",
    "format-connected": "󰂱",
    "format-connected-battery": "{device_alias} [{device_battery_percentage}%] ",
    "format-device-preference": ["ugreen_1", "ugreen_2"],
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
    "on-click": "alacritty --class bluetui -e bluetui"
  },
  "hyprland/submap": {
    "format": "✨ {} ✨",
    "tooltip": false
  },
  "custom/powerprofile": {
    "exec": "~/.local/bin/powerprofile --print",
    "return-type": "json",
    "interval": 5,
    "on-click": "~/.local/bin/powerprofile --cycle",
    "on-click-right": "~/.local/bin/powerprofile --set balanced",
    "on-scroll-up": "~/.local/bin/powerprofile --set performance",
    "on-scroll-down": "~/.local/bin/powerprofile --set power-saver",
    "tooltip": true
  },
  "mpris": {
    "interval": 15,
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} <i>{dynamic}</i>",
    "dynamic-order": ["artist", "title"],
    "dynamic-len": 30,
    "player-icons": {
      "default": "▶",
      "firefox": "▶",
      "spotify": "󰓇"
    },
    "status-icons": {
      "paused": "⏸"
    }
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },
  "tray": {
    "icon-size": 13,
    "spacing": 10
  },
  "clock": {
    "interval": 60,
    "timezone": "America/Denver",
    "format": "{:%F %R }",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#cba6f7'><b>{}</b></span>",
        "days": "<span color='#cdd6f4'><b>{}</b></span>",
        "weeks": "<span color='#94e2d5'>W{}</span>",
        "weekdays": "<span color='#f9e2af'><b>{}</b></span>",
        "today": "<span color='#1e1e2e' background='#f38ba8'><b>{}</b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-click-forward": "tz_up",
      "on-click-backward": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "custom/weather": {
    "exec": "curl -s 'wttr.in/?format=%c+%t&u'",
    "interval": 3600,
    "format": "{}"
  },
  "cpu": {
    "interval": 3,
    "format": "{usage}% ",
    "on-click": "alacritty --class btop -e btop"
  },
  "memory": {
    "interval": 3,
    "format": "{}% ",
    "on-click": "alacritty --class btop -e btop",
    "tooltip-format": "Used: {used:0.1f}G/{total:0.1f}G. Swap: {swapUsed:0.1f}G/{swapTotal:0.1f}G",
    "states": {
      "critical": 80
    }
  },
  "disk#ssd": {
    "interval": 60,
    "format": "{percentage_used}% ",
    "path": "/",
    "tooltip": true,
    "tooltip-format": "Used: {used} / Total: {total}",
    "warning": 80,
    "critical": 90
  },
  "network": {
    "interval": 60,
    "interface-ethernet": "enp1s*",
    "interface-wifi": "wlan0",
    "format-ethernet": "eth 󰈀",
    "format-wifi": "",
    "format-disconnected": "󰤭 ",
    "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr} ",
    "tooltip-format-wifi": "{essid} | {ifname}: {ipaddr}/{cidr} ",
    "tooltip-format-disconnected": "Disconnected",
    "format-linked": "(No IP) ",
    "on-click": "alacritty --class nmtui -e nmtui"
  },
  "pulseaudio": {
    "scroll-step": 2,
    "format": "{volume}% {icon} {format_source}",
    "format-bluetooth": "{volume}% {icon} {format_source}",
    "format-bluetooth-muted": " {icon} {format_source}",
    "format-muted": "󰖁 {format_source}",
    "format-source": "{volume}% ",
    "format-source-muted": "",
    "format-icons": {
      "headphone": " ",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": ""
    },
    "on-click": "alacritty --class pulsemixer -e pulsemixer"
  },
  "custom/tailscale": {
    "exec": "tailscale status --json 2>/dev/null | jq -r 'if .BackendState == \"Running\" then \"󰛳\" else \"\" end'",
    "return-type": "",
    "interval": 5,
    "tooltip-format": "Tailscale: {}",
    "exec-tooltip": "tailscale status --json 2>/dev/null | jq -r 'if .BackendState == \"Running\" then \"Connected\" else \"Disconnected\" end'",
    "on-click": "~/.config/hypr/scripts/tailscale-toggle.sh"
  }
}
