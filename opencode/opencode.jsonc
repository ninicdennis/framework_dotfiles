{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
    },
  },
  "agent": {
    "build": {
      "mode": "primary",
      "model": "openrouter/minimax/minimax-m2.7",
    },
    "plan": {
      "mode": "primary",
      "model": "openrouter/anthropic/claude-sonnet-4.6",
      "permission": {
        "edit": "ask",
        "bash": "ask",
      },
    },
  },
  "tools": {
    "websearch": true,
    "codesearch": true,
  },
}
