{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "openrouter/anthropic/claude-haiku-4.5",
  "default_agent": "build",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**", "*.lock", "coverage/**"]
  },
  "permission": {
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git diff": "allow",
      "cat *": "allow",
      "ls *": "allow",
      "echo *": "allow",
      "pwd": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
    },
  },
  "agent": {
    "build": {
      "mode": "primary",
      "model": "openrouter/minimax/minimax-m2.7",
    },
    "plan": {
      "mode": "primary",
      "model": "openrouter/anthropic/claude-sonnet-4.6",
      "permission": {
        "edit": "ask",
        "bash": "ask",
      },
    },
    "project-researcher": {
      "mode": "primary",
      "model": "openrouter/anthropic/claude-sonnet-4.6",
    },
    "research-worker": {
      "mode": "subagent",
      "model": "openrouter/anthropic/claude-haiku-4.5",
    },
  },
  "tools": {
    "websearch": true,
    "codesearch": true,
  },
}
